APP_NAME=BizTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://snow-aardvark-815146.hostingersite.com
FRONTEND_URL=https://snow-aardvark-815146.hostingersite.com
CORS_ALLOWED_ORIGINS=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite is suitable for this single-server demo deployment. Use an absolute path.
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/backend/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Keep false in normal production. Enable only for a disposable demo database.
SEED_DEMO_DATA=false
DEMO_USER_EMAIL=demo@biztrack.app
DEMO_USER_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_EMAIL=admin@biztrack.com
SUPER_ADMIN_PASSWORD=
